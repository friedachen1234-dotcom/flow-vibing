{
  "version": 1,
  "id": "baseline",
  "name": "Baseline",
  "brief": "A training program in your pocket. You pick a goal, the program lays out the weeks, and a coach adjusts the plan as life happens. Home answers one question, what should I do this week, with the next session first and the weekly targets beside it. Progress, the plan, the calendar and the coach are one tap away, and any of them can change the plan. Dark, calm, data-forward.",
  "device": {
    "kind": "mobile",
    "width": 390,
    "height": 844
  },
  "tokens": {
    "colors": {
      "bg": "#101518",
      "surface": "#202528",
      "surface-2": "#293238",
      "ink": "#FFFFFF",
      "muted": "#B3B5B7",
      "dim": "#808386",
      "line": "#25292C",
      "accent": "#67AEE6",
      "accent-ink": "#04101A",
      "recovery": "#00F19F",
      "strain": "#0093E7",
      "sleep": "#7BA1BB",
      "warning": "#FCAC5D",
      "critical": "#FF0026",
      "coach": "#8B62FF"
    },
    "type": {
      "body": "Figtree, system-ui, -apple-system, sans-serif",
      "display": "Figtree, system-ui, -apple-system, sans-serif",
      "mono": "Barlow, ui-monospace, Menlo, monospace"
    },
    "spacing": {
      "unit": "8px",
      "page": "16px"
    },
    "radius": {
      "card": "16px",
      "control": "12px",
      "pill": "999px"
    },
    "motion": {
      "fast": "140ms",
      "base": "220ms"
    }
  },
  "components": [
    {
      "id": "session-card",
      "name": "Session card",
      "description": "Icon tile, name and detail; a check once done. Taps open the session drawer",
      "usedIn": [
        "program",
        "calendar"
      ]
    },
    {
      "id": "target-ring",
      "name": "Target ring",
      "description": "Small ring per weekly target, count inside or beside it",
      "usedIn": [
        "program"
      ]
    },
    {
      "id": "trend-graph",
      "name": "Trend graph",
      "description": "Goal line in white, actuals in blue, completion in green",
      "usedIn": [
        "progress-tab",
        "progress"
      ]
    },
    {
      "id": "ask-bar",
      "name": "Ask bar",
      "description": "Docked composer that opens the coach with the current context",
      "usedIn": [
        "program",
        "progress",
        "plan",
        "calendar"
      ]
    }
  ],
