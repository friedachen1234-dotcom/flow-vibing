  "edgeCases": [
    {
      "id": "missed-session",
      "attachedTo": {
        "screenId": "program"
      },
      "scenario": "A key session was missed yesterday",
      "handling": "Keep it in the schedule, marked missed rather than gone. The coach offers to move it; the week's targets do not reset.",
      "severity": "medium"
    },
    {
      "id": "first-week",
      "attachedTo": {
        "screenId": "progress-tab"
      },
      "scenario": "First week of the program: one data point, no trend yet",
      "handling": "Show the starting point and the goal line only, and say when the first trend will appear. Never draw a flat line as if it were a result.",
      "severity": "high"
    },
    {
      "id": "end-by-mistake",
      "attachedTo": {
        "transitionId": "menu-to-coach"
      },
      "scenario": "Someone taps End your program meaning to pause",
      "handling": "Ending always confirms, and offers Ease off or pause first. Ending keeps the history.",
      "severity": "high"
    },
    {
      "id": "locked-phase",
      "attachedTo": {
        "screenId": "calendar"
      },
      "scenario": "Looking at weeks in a phase that is still locked",
      "handling": "Show the weeks with their shape but no sessions, and say what unlocks them: the checkpoint at the end of this phase.",
      "severity": "low"
    }
  ]
}